{
  "name": "office-town",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run --testTimeout=20000",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:run": "node packages/harness/dev/run.ts",
    "dev:catalog": "node packages/harness/dev/catalog.ts",
    "dev:core": "node packages/service/src/main.ts",
    "dev:web": "node apps/desktop/dev/web.ts",
    "dev:app": "pnpm --filter @office-town/desktop build && pnpm --filter @office-town/desktop start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
